{
  "name": "company-knowledge-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm -r test:integration",
    "test:security": "pnpm build:packages && pnpm -r test:security",
    "test:e2e": "pnpm build && pnpm --filter @cka/e2e test:e2e",
    "test:deploy": "pnpm --filter @cka/e2e test:deploy",
    "eval": "pnpm build:packages && pnpm --filter @cka/api eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cka/database db:generate",
    "db:migrate": "pnpm build:packages && pnpm --filter @cka/database db:migrate",
    "db:seed:demo": "pnpm build:packages && pnpm --filter @cka/database db:seed:demo",
    "db:provision": "pnpm build:packages && pnpm --filter @cka/database db:provision",
    "db:studio": "pnpm --filter @cka/database exec drizzle-kit studio --config drizzle.studio.config.ts",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait postgres object-storage && docker compose -f infra/docker/compose.yaml run --rm storage-init",
    "infra:auth": "docker compose -f infra/docker/compose.yaml --profile auth up -d --wait oidc",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "infra:check": "sh infra/docker/check.sh",
    "deploy:rehearsal": "bash infra/deploy/rehearsal.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
