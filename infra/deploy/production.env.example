# Staging/production environment for the API, worker and deployment steps
# (infra/deploy/compose.yaml). Copy to a host-side file OUTSIDE the repository
# (or render it from the secret manager) and point CKA_ENV_FILE at it. Each
# environment (staging, production) has its OWN file, database, bucket, IdP
# client and AI key: never share credentials between environments.
#
# [secret] marks values that must come from the secret manager. Startup fails
# fast, naming the variable (never the value), if anything is missing/invalid.
# The full list with defaults is in packages/config/src/schema.ts.

NODE_ENV=production
LOG_LEVEL=log

# Public HTTPS origins (https is enforced in production).
APP_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
# Defaults to APP_PUBLIC_URL's origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Managed PostgreSQL 15+ with the pgvector extension available. [secret]
# Require verified TLS to the database: sslmode=verify-full (or require).
DATABASE_URL=postgresql://cka_app:CHANGE_ME@db.example.internal:5432/company_knowledge?sslmode=verify-full

# Private S3-compatible bucket (block public access; versioning recommended).
# Omit S3_ENDPOINT for AWS S3; set it (and usually S3_FORCE_PATH_STYLE=true)
# for other providers.
# S3_ENDPOINT=https://storage.example.com
S3_REGION=eu-west-2
S3_BUCKET=cka-staging-documents
# [secret]
S3_ACCESS_KEY=CHANGE_ME
# [secret]
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false

# OIDC provider issuing JWT access tokens (RS/ES/PS signed) for this API.
AUTH_ISSUER_URL=https://login.example.com/
AUTH_AUDIENCE=company-knowledge-api
AUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# Claims carrying email/name in ACCESS tokens (namespaced claims are fine).
# AUTH_EMAIL_CLAIM=email
# AUTH_NAME_CLAIM=name

# AI provider (OpenAI or a compatible endpoint, e.g. Azure OpenAI).
AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# [secret]
AI_API_KEY=CHANGE_ME
AI_GENERATION_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must be 1536 (database vector column); another size needs a migration.
AI_EMBEDDING_DIMENSIONS=1536
# AI_REQUEST_TIMEOUT_MS=30000
# Evidence thresholds are model-specific: calibrate with `pnpm eval` before
# changing the embedding model (docs/rag-evaluation).
# EVIDENCE_MIN_TOP_SCORE=0.35
# EVIDENCE_MIN_HIT_SCORE=0.25

# Abuse controls are per API instance (one API container per environment in
# this topology); see the runbook before scaling the API horizontally.
# RATE_LIMIT_REQUESTS_PER_IP=600
# RATE_LIMIT_AUTH_FAILURES_PER_IP=20
# RATE_LIMIT_ASKS_PER_USER=20
# RATE_LIMIT_UPLOADS_PER_USER=30
# TRUST_PROXY is set by compose.yaml (1 = the edge). Add one per extra proxy.

# Bearer token for GET /metrics (>= 16 chars). Unset disables the endpoint. [secret]
# METRICS_TOKEN=
