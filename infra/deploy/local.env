# Rehearsal environment (compose.local.yaml). Local stand-in values only: NOT
# secrets and never used outside the rehearsal. Production uses a host-side
# file built from production.env.example and the secret manager.
NODE_ENV=production
LOG_LEVEL=log
APP_PUBLIC_URL=https://app.localhost
API_PUBLIC_URL=https://api.localhost

DATABASE_URL=postgresql://cka:cka_rehearsal_only@postgres:5432/company_knowledge

S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_BUCKET=cka-documents
S3_ACCESS_KEY=cka_rehearsal_access
S3_SECRET_KEY=cka_rehearsal_secret
S3_FORCE_PATH_STYLE=true

AUTH_ISSUER_URL=https://auth.localhost/default
AUTH_AUDIENCE=company-knowledge-api
AUTH_JWKS_URL=https://auth.localhost/default/jwks

AI_PROVIDER=openai-compatible
AI_BASE_URL=http://ai-stub:39102/v1
AI_API_KEY=sk-rehearsal-stand-in
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_GENERATION_MODEL=rehearsal-extractive
# Calibrated for the offline embedding stand-in (docs/rag-evaluation).
EVIDENCE_MIN_TOP_SCORE=0.30
EVIDENCE_MIN_HIT_SCORE=0.20

JOB_POLL_INTERVAL_MS=500
METRICS_TOKEN=rehearsal-metrics-token-not-secret
