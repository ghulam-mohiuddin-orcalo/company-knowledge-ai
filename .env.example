# Backend configuration (apps/api, apps/worker). Copy to `.env` for local development.
# Validated at startup by packages/config; see that package for every supported variable.
# Values below match the local stack in infra/docker (local development only).

# App
NODE_ENV=development
LOG_LEVEL=log
PORT=3001
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://cka:cka_local_dev@127.0.0.1:5432/company_knowledge

# Object storage (S3-compatible)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=cka-documents-local
S3_ACCESS_KEY=cka_local_access
S3_SECRET_KEY=cka_local_secret
S3_FORCE_PATH_STYLE=true

# Authentication (required by the API). Any OIDC provider issuing JWT access
# tokens signed with asymmetric keys. The values below use the local mock
# provider (`pnpm infra:auth`, development only); replace them with your
# provider's values in every other environment.
AUTH_ISSUER_URL=http://localhost:8080/default
AUTH_AUDIENCE=company-knowledge-api
AUTH_JWKS_URL=http://localhost:8080/default/jwks
# Access-token claims holding the user's email/name (namespaced custom claims are fine).
# AUTH_EMAIL_CLAIM=email
# AUTH_NAME_CLAIM=name
# Used by the web sign-in flow, not by the API:
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# AI providers. Embedding settings are required by the worker.
# 'openai-compatible' = OpenAI embeddings API (or a compatible server via AI_BASE_URL).
AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the database vector column (1536); other models need a migration.
AI_EMBEDDING_DIMENSIONS=1536
# Required by the API (answer generation).
AI_GENERATION_MODEL=gpt-4.1-mini
# AI_EMBEDDING_BATCH_SIZE=64
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=1024

# Uploads
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Retrieval and evidence policy (calibrate thresholds per embedding model with `pnpm eval`)
# RETRIEVAL_CANDIDATES=10
# RETRIEVAL_MAX_EVIDENCE=5
# RETRIEVAL_MAX_PER_DOCUMENT=3
# EVIDENCE_MIN_TOP_SCORE=0.35
# EVIDENCE_MIN_HIT_SCORE=0.25
# QUESTION_MAX_CHARS=2000

# Chunking (token-aware; tune against the evaluation corpus)
# CHUNK_SIZE_TOKENS=800
# CHUNK_OVERLAP_TOKENS=120

# Background jobs
# JOB_POLL_INTERVAL_MS=2000
# JOB_MAX_ATTEMPTS=3
# JOB_RETRY_BACKOFF_MS=5000
# JOB_LEASE_MS=600000

# Abuse controls (per API instance; fixed window). Exceeding a limit returns
# 429 RATE_LIMITED with Retry-After. Health probes are exempt.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_REQUESTS_PER_IP=600
# RATE_LIMIT_AUTH_FAILURES_PER_IP=20
# RATE_LIMIT_ASKS_PER_USER=20
# RATE_LIMIT_UPLOADS_PER_USER=30
# Number of trusted reverse proxies in front of the API (client IP from
# X-Forwarded-For, unspoofable): 0/false = none, 1/true = one TLS proxy.
# TRUST_PROXY=0

# Operational metrics: GET /metrics (Prometheus) requires this bearer token
# (at least 16 characters). Unset = endpoint disabled.
# METRICS_TOKEN=
