# Backend configuration (apps/api, apps/worker). Copy to `.env` for local development.
# Validated at startup by packages/config; see that package for every supported variable.
# Values below match the local stack in infra/docker (local development only).

# App
NODE_ENV=development
LOG_LEVEL=log
PORT=3001
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://cka:cka_local_dev@127.0.0.1:5432/company_knowledge

# Object storage (S3-compatible)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=cka-documents-local
S3_ACCESS_KEY=cka_local_access
S3_SECRET_KEY=cka_local_secret
S3_FORCE_PATH_STYLE=true

# Authentication (required once E1-T01 integrates a provider)
# AUTH_ISSUER_URL=
# AUTH_AUDIENCE=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# AI providers (required once E3-T04 / E5-T02 integrate providers)
# AI_PROVIDER=
# AI_API_KEY=
# AI_GENERATION_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=
# AI_EMBEDDING_BATCH_SIZE=64
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=1024

# Uploads
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Background jobs
# JOB_POLL_INTERVAL_MS=2000
# JOB_MAX_ATTEMPTS=3
# JOB_RETRY_BACKOFF_MS=5000
