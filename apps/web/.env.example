# Public browser configuration (inlined at build time; never put secrets here).
# Defaults match the local stack: `pnpm infra:up && pnpm infra:auth`.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/default
NEXT_PUBLIC_OIDC_CLIENT_ID=company-knowledge-web
# NEXT_PUBLIC_OIDC_SCOPE=openid profile email
# Needed by some providers (e.g. Auth0) to issue an access token for the API:
# NEXT_PUBLIC_OIDC_AUDIENCE=company-knowledge-api
