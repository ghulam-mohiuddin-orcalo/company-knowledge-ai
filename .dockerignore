# Build context for the production images (Dockerfile). Everything is rebuilt
# inside the image from the lockfile and sources; nothing local leaks in.
.git
**/node_modules
**/dist
**/.next
**/out
**/*.tsbuildinfo
**/next-env.d.ts
**/coverage
**/eval-reports
**/test-results
**/playwright-report

# Secrets and local environment files never enter an image.
**/.env
**/.env.*
!**/.env.example

# Not needed to build or run the apps.
docs
infra
*.md
**/*.log
.github
.vscode
.idea
