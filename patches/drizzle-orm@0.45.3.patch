diff --git a/node-postgres/session.cjs b/node-postgres/session.cjs
index 8ef1fbdb684c7b9a8fb0e832f9470659707905f9..1354733daab3e8e8096d10eb093376ab4b9904d8 100644
--- a/node-postgres/session.cjs
+++ b/node-postgres/session.cjs
@@ -216,16 +216,24 @@ class NodePgSession extends import_session.PgSession {
     const isPool = this.client instanceof Pool || Object.getPrototypeOf(this.client).constructor.name.includes("Pool");
     const session = isPool ? new NodePgSession(await this.client.connect(), this.dialect, this.schema, this.options) : this;
     const tx = new NodePgTransaction(this.dialect, session, this.schema);
-    await tx.execute(import_sql.sql`begin${config ? import_sql.sql` ${tx.getTransactionConfigSQL(config)}` : void 0}`);
+    // Patched (company-knowledge-ai, E8-T06): BEGIN inside try so a client whose
+    // connection fails at BEGIN is still released, and a client whose ROLLBACK
+    // fails is discarded instead of returned to the pool.
+    let releaseError;
     try {
+      await tx.execute(import_sql.sql`begin${config ? import_sql.sql` ${tx.getTransactionConfigSQL(config)}` : void 0}`);
       const result = await transaction(tx);
       await tx.execute(import_sql.sql`commit`);
       return result;
     } catch (error) {
-      await tx.execute(import_sql.sql`rollback`);
+      try {
+        await tx.execute(import_sql.sql`rollback`);
+      } catch (rollbackError) {
+        releaseError = rollbackError;
+      }
       throw error;
     } finally {
-      if (isPool) session.client.release();
+      if (isPool) session.client.release(releaseError);
     }
   }
   async count(sql2) {
