{
  "name": "@cka/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/document-fixtures.d.ts",
      "default": "./dist/fixtures/document-fixtures.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.0.0"
  },
  "devDependencies": {
    "@cka/eslint-config": "workspace:*",
    "@cka/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
